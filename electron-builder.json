{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "io.github.pasukalu.viewportguard",
  "productName": "Viewport Guard",
  "asar": false,
  "directories": {
    "output": "release"
  },
  "files": [
    "package.json",
    "dist/**/*",
    "desktop/**/*",
    "demo/**/*",
    "scripts/demo-server.mjs",
    "assets/brand/mascot.png",
    "assets/brand/NOTICE.md"
  ],
  "extraResources": [
    {
      "from": ".artifacts/desktop-browsers",
      "to": "browsers",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "icon": "desktop/assets/icon.ico",
    "target": [
      { "target": "dir", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] },
      { "target": "nsis", "arch": ["x64"] }
    ]
  },
  "portable": {
    "artifactName": "Viewport-Guard-${version}-win-${arch}-portable.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Viewport Guard",
    "artifactName": "Viewport-Guard-${version}-win-${arch}-setup.${ext}"
  },
  "mac": {
    "icon": "desktop/assets/icon.png",
    "category": "public.app-category.developer-tools",
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "artifactName": "Viewport-Guard-${version}-mac-${arch}.${ext}",
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] },
      { "target": "zip", "arch": ["arm64", "x64"] }
    ]
  },
  "dmg": {
    "title": "Viewport Guard ${version}"
  },
  "linux": {
    "icon": "desktop/assets/icon.png",
    "category": "Development",
    "maintainer": "Pasukalu <52987556+Pasukalu@users.noreply.github.com>",
    "synopsis": "Responsive horizontal overflow scanner and offline HTML reporter",
    "description": "Your whale-girl lookout for responsive layouts: inspect horizontal overflow across viewports with bundled Chromium and export standalone offline HTML reports.",
    "artifactName": "Viewport-Guard-${version}-linux-${arch}.${ext}",
    "desktop": {
      "entry": {
        "Name": "Viewport Guard",
        "Comment": "Responsive horizontal overflow scanner and offline HTML reporter",
        "Categories": "Development;WebDevelopment;"
      }
    },
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb", "arch": ["x64"] },
      { "target": "tar.gz", "arch": ["x64"] }
    ]
  }
}
